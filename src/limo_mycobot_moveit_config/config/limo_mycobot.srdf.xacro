<?xml version="1.0"?>
<!-- SRDF for the LIMO + myCobot 280 (with_arm:=true). Links carry the robot_name prefix
     (robot_0/joint1, ...), joints do not. Only the arm is planned; the gripper linkage
     (no <mimic> in sim) is driven by mycobot_sim_bridge.py and only used for collisions. -->
<robot name="limo_four_diff" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="robot_name" default="robot_0"/>
  <xacro:property name="p" value="$(arg robot_name)/"/>

  <group name="arm">
    <chain base_link="${p}g_base" tip_link="${p}joint6_flange"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint2_to_joint1" value="0"/>
    <joint name="joint3_to_joint2" value="0"/>
    <joint name="joint4_to_joint3" value="0"/>
    <joint name="joint5_to_joint4" value="0"/>
    <joint name="joint6_to_joint5" value="0"/>
    <joint name="joint6output_to_joint6" value="0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="joint2_to_joint1" value="0"/>
    <joint name="joint3_to_joint2" value="0.5"/>
    <joint name="joint4_to_joint3" value="-1.0"/>
    <joint name="joint5_to_joint4" value="-0.5"/>
    <joint name="joint6_to_joint5" value="0"/>
    <joint name="joint6output_to_joint6" value="0"/>
  </group_state>

  <end_effector name="gripper" parent_link="${p}joint6_flange" group="arm"/>

  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="${p}base_footprint"/>

  <!-- arm links among themselves: joint limits keep the chain from folding onto itself,
       and the coarse meshes overlap at many poses -->
  <disable_collisions link1="${p}g_base" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}joint4" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}joint5" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}joint6" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}joint6_flange" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}joint4" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}joint5" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}joint6" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}joint6_flange" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}joint4" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}joint5" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}joint6" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}joint6_flange" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}joint4" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}joint5" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}joint6" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}joint6_flange" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}joint5" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}joint6" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}joint6_flange" reason="Never"/>
  <disable_collisions link1="${p}joint5" link2="${p}joint6" reason="Never"/>
  <disable_collisions link1="${p}joint5" link2="${p}joint6_flange" reason="Never"/>
  <disable_collisions link1="${p}joint6" link2="${p}joint6_flange" reason="Never"/>
  <!-- LIMO body vs arm base -->
  <disable_collisions link1="${p}base_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}rear_right_wheel_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}rear_right_wheel_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}rear_right_wheel_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}rear_right_wheel_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}laser_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}laser_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}laser_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}laser_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}depth_camera_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}depth_camera_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}depth_camera_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}depth_camera_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}imu_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}imu_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}imu_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}imu_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}depth_link" link2="${p}g_base" reason="Never"/>
  <disable_collisions link1="${p}depth_link" link2="${p}joint1" reason="Never"/>
  <disable_collisions link1="${p}depth_link" link2="${p}joint2" reason="Never"/>
  <disable_collisions link1="${p}depth_link" link2="${p}joint3" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}inertial_link" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}front_left_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}rear_left_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}laser_link" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}depth_camera_link" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}imu_link" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}depth_link" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}front_left_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}rear_left_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}laser_link" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}depth_camera_link" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}imu_link" reason="Never"/>
  <disable_collisions link1="${p}inertial_link" link2="${p}depth_link" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}rear_left_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}laser_link" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}depth_camera_link" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}imu_link" reason="Never"/>
  <disable_collisions link1="${p}front_left_wheel_link" link2="${p}depth_link" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}rear_left_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}laser_link" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}depth_camera_link" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}imu_link" reason="Never"/>
  <disable_collisions link1="${p}front_right_wheel_link" link2="${p}depth_link" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}laser_link" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}depth_camera_link" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}imu_link" reason="Never"/>
  <disable_collisions link1="${p}rear_left_wheel_link" link2="${p}depth_link" reason="Never"/>
  <disable_collisions link1="${p}rear_right_wheel_link" link2="${p}laser_link" reason="Never"/>
  <disable_collisions link1="${p}rear_right_wheel_link" link2="${p}depth_camera_link" reason="Never"/>
  <disable_collisions link1="${p}rear_right_wheel_link" link2="${p}imu_link" reason="Never"/>
  <disable_collisions link1="${p}rear_right_wheel_link" link2="${p}depth_link" reason="Never"/>
  <disable_collisions link1="${p}laser_link" link2="${p}depth_camera_link" reason="Never"/>
  <disable_collisions link1="${p}laser_link" link2="${p}imu_link" reason="Never"/>
  <disable_collisions link1="${p}laser_link" link2="${p}depth_link" reason="Never"/>
  <disable_collisions link1="${p}depth_camera_link" link2="${p}imu_link" reason="Never"/>
  <disable_collisions link1="${p}depth_camera_link" link2="${p}depth_link" reason="Never"/>
  <disable_collisions link1="${p}imu_link" link2="${p}depth_link" reason="Never"/>
  <!-- gripper linkage and its mount -->
  <disable_collisions link1="${p}joint5" link2="${p}gripper_base" reason="Never"/>
  <disable_collisions link1="${p}joint5" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}joint5" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}joint5" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}joint5" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}joint5" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}joint5" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}joint6" link2="${p}gripper_base" reason="Never"/>
  <disable_collisions link1="${p}joint6" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}joint6" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}joint6" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}joint6" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}joint6" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}joint6" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}joint6_flange" link2="${p}gripper_base" reason="Never"/>
  <disable_collisions link1="${p}joint6_flange" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}joint6_flange" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}joint6_flange" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}joint6_flange" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}joint6_flange" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}joint6_flange" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}gripper_base" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}gripper_base" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}gripper_base" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}gripper_base" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}gripper_base" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}gripper_base" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}gripper_left1" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}gripper_left1" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}gripper_left1" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}gripper_left1" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}gripper_left1" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}gripper_left2" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}gripper_left2" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}gripper_left2" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}gripper_left2" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}gripper_left3" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}gripper_left3" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}gripper_left3" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}gripper_right1" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}gripper_right1" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}gripper_right2" link2="${p}gripper_right3" reason="Never"/>
  <!-- g_base is the fixed mount plate under joint1 (its mm-scale mesh can be loaded unscaled) -->
  <disable_collisions link1="${p}g_base" link2="${p}gripper_base" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}g_base" link2="${p}gripper_right3" reason="Never"/>
  <!-- gripper vs lower arm: mm-scale gripper meshes give false contacts; the arm limits keep them apart -->
  <disable_collisions link1="${p}joint1" link2="${p}gripper_base" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}joint1" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}gripper_base" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}joint2" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}gripper_base" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}joint3" link2="${p}gripper_right3" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}gripper_base" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}gripper_left1" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}gripper_left2" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}gripper_left3" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}gripper_right1" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}gripper_right2" reason="Never"/>
  <disable_collisions link1="${p}joint4" link2="${p}gripper_right3" reason="Never"/>
</robot>
