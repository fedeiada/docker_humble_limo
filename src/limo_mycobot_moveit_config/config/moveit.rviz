# ROBOT_NAME is replaced by moveit.launch.py
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: /ROBOT_NAME
      Robot Description: robot_description
      Planning Scene Topic: /ROBOT_NAME/monitored_planning_scene
      Planning Request:
        Planning Group: arm
        Interactive Marker Size: 0.1
        Query Goal State: true
        Query Start State: false
      Planned Path:
        Trajectory Topic: /ROBOT_NAME/display_planned_path
        Loop Animation: false
        Show Robot Visual: true
        State Display Time: 0.05 s
      Scene Robot:
        Show Robot Visual: true
        Show Robot Collision: false
  Global Options:
    Fixed Frame: ROBOT_NAME/base_footprint
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.0
      Focal Point: {X: 0.0, Y: 0.0, Z: 0.2}
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
